    <script>
    let taxSwitch = document.getElementById("switchCheckDefault");

    taxSwitch.addEventListener("click", () => {

        let taxInfo = document.getElementsByClassName("gst");
        let prices = document.getElementsByClassName("listing-price");

        for (let i = 0; i < taxInfo.length; i++) {

            if (taxSwitch.checked) {

                // GST text show
                taxInfo[i].style.display = "inline";

                // Original price
                let originalPrice = Number(
                    prices[i].getAttribute("data-price")
                );

                // 18% GST
                let gst = originalPrice * 0.18;

                // Price + GST
                let totalPrice = originalPrice + gst;

                prices[i].innerHTML =
                    "&#8377;" +
                    Math.round(totalPrice).toLocaleString("en-IN");

            } else {

                // GST text hide
                taxInfo[i].style.display = "none";

                // Original price
                let originalPrice = Number(
                    prices[i].getAttribute("data-price")
                );

                prices[i].innerHTML =
                    "&#8377;" +
                    originalPrice.toLocaleString("en-IN");
            }
        }
    });
</script>
