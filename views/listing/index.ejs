<% layout("/layouts/boilerplate") %>
<style>
 #filters{
  display: flex;
  flex-wrap: wrap;
  align-items: center;
 }
 .filter{
  text-align: center;
  margin-right: 2rem;
  margin-top: 2rem;
  opacity: 0.7;
 }
 .filter:hover{
 opacity: 1;
 cursor: pointer;
 }
 .filter p{
  font-size: 0.9rem;
 }
 #filters a{
  text-decoration: none;
  color: #000;
 }
 .gst{
  display: none;
 }
 .tax-toggle{
  border: 1px solid black;
  border-radius: 1rem;
  height: 2.5rem;
  padding: 1rem;
 margin-left:4rem ;
 display: flex;
 align-items: center;
 }
 /* lkffdskd. */

 @media (max-width: 768px){

  #filters{
    flex-wrap: nowrap;           /* wrap band */
    overflow-x: auto;            /* scroll enable */
    gap: 1rem;
  }

  #filters::-webkit-scrollbar{
    display: none;               /* scrollbar hide */
  }

  .filter{
    margin: 0;
    min-width: 80px;             /* fixed width so scroll works */
    font-size: 12px;
  }

  .filter i{
    font-size: 18px;
  }

  /* tax full width niche aa jaye */
  .tax-toggle{
    min-width: 100%;
    margin-left: 0;
    margin-top: 1rem;
    justify-content: center;
  }
}

</style>

