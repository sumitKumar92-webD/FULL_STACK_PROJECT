<% layout("/layouts/boilerplate") %>

<div class="container my-5">
    <!-- Page Heading -->
    <div class="mb-4">
        <h2 class="fw-bold">My Bookings</h2>
        <p class="text-muted">
            Manage and view all your bookings
        </p>
    </div>

    <% if (bookings.length === 0) { %>
        <!-- No Booking -->
        <div class="text-center py-5">
            <div style="font-size: 55px;">
                🏡
            </div>
            <h4 class="mt-3">
                No bookings yet
            </h4>
            <p class="text-muted">
                Start exploring places and book your next stay.
            </p>
            <a
                href="/listing"
                class="btn btn-danger rounded-pill px-4"
            >
                Explore Places
            </a>
        </div>

    <% } else { %>
        <!-- Booking List -->
        <div class="row g-4">
            <% bookings.forEach(booking => { %>
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="row g-0">
                            <!-- Image -->
                            <div class="col-md-4">
                                <% if (
                                    booking.listing &&
                                    booking.listing.image &&
                                    booking.listing.image.url
                                ) { %>
                                    <img
                                        src="<%= booking.listing.image.url %>"
                                        class="w-100 h-100"
                                        style="min-height: 260px; object-fit: cover;"
                                        alt="<%= booking.listing.title %>"
                                    >
                                <% } else { %>
                                    <div
                                        class="d-flex align-items-center justify-content-center bg-light"
                                        style="min-height: 260px;"
                                    >
                                        <span class="text-muted">
                                            No Image
                                        </span>
                                    </div>
                                <% } %>
                            </div>
                            <!-- Booking Details -->
                            <div class="col-md-8">
                                <div class="card-body p-4">
                                    <!-- Title + Status -->
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h4 class="fw-bold mb-1">
                                                <%= booking.listing
                                                    ? booking.listing.title
                                                    : "Listing unavailable"
                                                %>
                                            </h4>
                                            <% if (booking.listing) { %>
                                                <p class="text-muted mb-3">

                                                    📍
                                                    <%= booking.listing.location %>,
                                                    <%= booking.listing.country %>

                                                </p>
                                            <% } %>
                                        </div>

                                        <span
                                            class="badge
                                            <%= booking.status === 'Booked'
                                                ? 'bg-success'
                                                : 'bg-danger'
                                            %>
                                            rounded-pill px-3 py-2"
                                        >
                                            <%= booking.status %>

                                        </span>
                                    </div>
                                    <hr>
                                    <!-- Booking Information -->
                                    <div class="row g-3 mb-3">
                                        <!-- Check In -->
                                        <div class="col-sm-6">
                                            <small class="text-muted d-block">
                                                Check-in
                                            </small>

                                            <strong>
                                                <%= new Date(
                                                    booking.checkIn
                                                ).toLocaleDateString(
                                                    "en-IN",
                                                    {
                                                        day: "numeric",
                                                        month: "short",
                                                        year: "numeric"
                                                    }
                                                ) %>
                                            </strong>
                                        </div>

                                        <!-- Check Out -->
                                        <div class="col-sm-6">
                                            <small class="text-muted d-block">
                                                Check-out
                                            </small>

                                            <strong>

                                                <%= new Date(
                                                    booking.checkOut
                                                ).toLocaleDateString(
                                                    "en-IN",
                                                    {
                                                        day: "numeric",
                                                        month: "short",
                                                        year: "numeric"
                                                    }
                                                ) %>
                                            </strong>
                                        </div>

                                        <!-- Guests -->
                                        <div class="col-sm-6">
                                            <small class="text-muted d-block">
                                                Guests
                                            </small>

                                            <strong>
                                                <%= booking.guests %>
                                                <%= booking.guests == 1
                                                    ? "Guest"
                                                    : "Guests"
                                                %>
                                            </strong>
                                        </div>

                                        <!-- Booking Date -->
                                        <div class="col-sm-6">

                                            <small class="text-muted d-block">
                                                Booked on
                                            </small>

                                            <strong>
                                                <%= new Date(
                                                    booking.createdAt
                                                ).toLocaleDateString(
                                                    "en-IN",
                                                    {
                                                        day: "numeric",
                                                        month: "short",
                                                        year: "numeric"
                                                    }
                                                ) %>
                                            </strong>
                                        </div>
                                    </div>
                                    <hr>

                                    <!-- Price -->
                                    <div class="d-flex justify-content-between align-items-end">
                                        <div>
                                            <small class="text-muted">
                                                Total amount including GST
                                            </small>
                                            <h4 class="fw-bold mb-0">
                                                ₹<%= booking.totalPrice
                                                    .toLocaleString("en-IN", {
                                                        maximumFractionDigits: 0
                                                    })
                                                %>
                                            </h4>
                                        </div>

                                        <!-- View Booking -->
                                        <a
                                            href="/bookings/<%= booking._id %>/confirmation"
                                            class="btn btn-outline-dark rounded-pill px-4"
                                        >
                                            View Details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>